{
 "owner": "pi-gcp",
 "host": "single-authorized-disposable-pod",
 "privilege": "root-or-sudo-n",
 "packages": [
  "build-essential",
  "cmake",
  "git",
  "ca-certificates",
  "curl",
  "zstd",
  "pkg-config",
  "binutils",
  "file",
  "time",
  "util-linux"
 ],
 "commands": [
  "apt-get update",
  "apt-get install -y build-essential cmake git ca-certificates curl zstd pkg-config binutils file time util-linux"
 ],
 "allowed_system_paths": [
  "/usr",
  "/bin",
  "/sbin",
  "/lib",
  "/lib64",
  "/etc",
  "/var/lib/apt",
  "/var/lib/dpkg",
  "/var/cache/apt",
  "/var/log"
 ],
 "dependencies": "package-manager-resolved-only",
 "study_root": "/work"
}
